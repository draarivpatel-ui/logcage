{
  "name": "logcage",
  "version": "1.0.0",
  "description": "Zero-dependency CWE-117 log injection, terminal escape sanitization and automatic secret redaction for Node.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/draarivpatel-ui/logcage.git"
  },
  "homepage": "https://github.com/draarivpatel-ui/logcage#readme",
  "bugs": {
    "url": "https://github.com/draarivpatel-ui/logcage/issues"
  },
  "type": "module",
  "main": "./cjs/index.cjs",
  "module": "./src/index.mjs",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.mjs",
      "require": "./cjs/index.cjs"
    }
  },
  "files": [
    "src",
    "cjs",
    "types",
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "GOOD_FIRST_ISSUES.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:fuzz": "node --test test/fuzz.test.js",
    "build:cjs": "node scripts/build-cjs.mjs",
    "check:cjs": "node scripts/build-cjs.mjs --check"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "security",
    "logging",
    "log-injection",
    "cwe-117",
    "ansi",
    "terminal-escapes",
    "secret-redaction",
    "pii-redaction",
    "ndjson",
    "zero-dependency"
  ],
  "license": "MIT",
  "sideEffects": false,
  "dependencies": {},
  "devDependencies": {
    "fast-check": "4.10.3"
  }
}
